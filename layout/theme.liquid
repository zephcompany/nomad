<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'FLAV ICO.jpg' | asset_url }}" type="image/jpeg" sizes="32x32">
    <link rel="shortcut icon" href="{{ 'FLAV ICO.jpg' | asset_url }}" type="image/jpeg">
    <link rel="apple-touch-icon" href="{{ 'FLAV ICO.jpg' | asset_url }}">
    <title>{% if page_title %}{{ page_title }}{% else %}NØMAD{% endif %}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'product-interactions.css' | asset_url | stylesheet_tag }}
    {{ 'home-products.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}

    <a
      id="NomadWhatsappFloat"
      href="https://wa.me/447414013807?text=Hi%20N%C3%98MAD%21%20I%20need%20help."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with NØMAD on WhatsApp"
      style="position:fixed!important;right:22px!important;bottom:24px!important;z-index:2147483647!important;width:auto!important;height:58px!important;min-width:58px!important;padding:0 18px 0 14px!important;border-radius:999px!important;background:#25D366!important;color:#06140b!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:10px!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important;text-decoration:none!important;box-shadow:0 10px 30px rgba(0,0,0,.25)!important;font-size:11px!important;font-weight:700!important;letter-spacing:.08em!important;text-transform:uppercase!important;line-height:1!important;"
    >
      <svg viewBox="0 0 32 32" aria-hidden="true" style="display:block!important;width:28px!important;height:28px!important;fill:currentColor!important;flex:0 0 28px!important;">
        <path d="M16.02 3.2C8.94 3.2 3.2 8.93 3.2 16c0 2.26.59 4.47 1.72 6.41L3.1 29l6.75-1.77A12.72 12.72 0 0 0 16.02 28.8h.01c7.07 0 12.81-5.74 12.81-12.81S23.1 3.2 16.02 3.2Zm0 23.44h-.01a10.55 10.55 0 0 1-5.38-1.47l-.39-.23-4 1.05 1.07-3.9-.25-.4A10.6 10.6 0 1 1 16.02 26.64Zm5.82-7.94c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.71.16-.21.32-.82 1.03-1.01 1.24-.18.21-.37.24-.69.08-.32-.16-1.34-.49-2.55-1.58-.94-.84-1.58-1.88-1.76-2.19-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.36-.26-.62-.52-.54-.71-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.08-1.11 2.63s1.14 3.05 1.3 3.26c.16.21 2.23 3.4 5.4 4.77.75.32 1.34.52 1.8.67.76.24 1.45.21 2 .13.61-.09 1.88-.77 2.14-1.51.26-.74.26-1.37.18-1.5-.08-.13-.29-.21-.61-.37Z"/>
      </svg>
      <span class="nomad-whatsapp-label" style="display:block!important;white-space:nowrap!important;">WhatsApp</span>
    </a>

    <style>
      #NomadWhatsappFloat:hover{transform:translateY(-3px)!important;box-shadow:0 14px 38px rgba(0,0,0,.3)!important}
      @media(max-width:640px){
        #NomadWhatsappFloat{right:14px!important;bottom:14px!important;width:58px!important;min-width:58px!important;padding:0!important}
        #NomadWhatsappFloat .nomad-whatsapp-label{display:none!important}
      }
    </style>
  </body>
</html>
