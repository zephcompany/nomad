<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'FLAV ICO.jpg' | asset_url }}" type="image/jpeg" sizes="32x32">
    <link rel="shortcut icon" href="{{ 'FLAV ICO.jpg' | asset_url }}" type="image/jpeg">
    <link rel="apple-touch-icon" href="{{ 'FLAV ICO.jpg' | asset_url }}">
    <title>{% if page_title %}{{ page_title }}{% else %}NØMAD{% endif %}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
  </body>
</html>
