<footer class="site-footer">
  <div class="page-width">
    <div class="footer-grid">
      <div>
        <a class="footer-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="360" height="120" loading="lazy">
        </a>
        <p style="max-width:330px;color:#aaa;margin-top:18px">Statement pieces made for people who move differently.</p>
      </div>
      <div class="footer-col"><h4>Shop</h4><a href="/collections/t-shirts">T-Shirts</a><a href="/collections/all">All Products</a><a href="{{ routes.account_url }}">Track Order</a></div>
      <div class="footer-col"><h4>Help</h4><a href="/pages/contact-us">Contact</a><a href="https://wa.me/447414013807?text=Hi%20N%C3%98MAD%21%20I%20need%20help." target="_blank" rel="noopener">WhatsApp Support</a><a href="/policies/shipping-policy">Shipping</a><a href="/policies/refund-policy">Returns</a><a href="/policies/privacy-policy">Privacy</a></div>
      <div class="footer-col"><h4>WhatsApp</h4><p>Orders, sizing, shipping or general questions.</p><a class="footer-whatsapp" href="https://wa.me/447414013807?text=Hi%20N%C3%98MAD%21%20I%20need%20help." target="_blank" rel="noopener">+44 7414 013807 →</a></div>
    </div>
    <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} NØMAD</span><span>Designed for movement.</span></div>
  </div>
</footer>

<style>
  .footer-logo{display:inline-block;line-height:0}
  .footer-logo img{width:190px;height:auto;filter:invert(1);opacity:.96}
  .footer-whatsapp{display:inline-block;margin-top:10px;color:#fff;border-bottom:1px solid #555;padding-bottom:4px}
  @media(max-width:640px){.footer-logo img{width:160px}}
</style>


<div class="zeph-credit">
  <a class="zeph-credit__link" href="https://www.instagram.com/zeph.rafa/" aria-label="Instagram @zeph.rafa">
    <img
      class="zeph-credit__image"
      src="https://tassiorenam.com.br/wp-content/uploads/2026/10/tiny-1.webp"
      alt="Zeph"
      loading="lazy"
    >
  </a>
</div>

<style>
  .zeph-credit{
    background:#000;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px 0;
  }
  .zeph-credit__link{
    display:block;
    width:80px;
    line-height:0;
  }
  .zeph-credit__image{
    display:block;
    width:100%;
    height:auto;
  }
  @media(max-width:767px){
    .zeph-credit__link{width:70px}
  }
</style>

{% schema %}{"name":"Footer","settings":[]}{% endschema %}
