<section class="hero">
  {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
    {% if section.settings.image_desktop != blank %}
      <picture>
        {% if section.settings.image_mobile != blank %}<source media="(max-width: 640px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">{% endif %}
        {{ section.settings.image_desktop | image_url: width: 3000 | image_tag: widths: '900,1200,1600,2200,3000', loading: 'eager', fetchpriority: 'high', alt: section.settings.alt }}
      </picture>
    {% else %}
      <div class="hero__placeholder">Upload your NØMAD hero banner in Customize</div>
    {% endif %}
  {% if section.settings.link != blank %}</a>{% endif %}
</section>
{% schema %}
{"name":"Image banner","settings":[{"type":"image_picker","id":"image_desktop","label":"Desktop banner"},{"type":"image_picker","id":"image_mobile","label":"Mobile banner"},{"type":"text","id":"alt","label":"Alt text","default":"NØMAD collection"},{"type":"url","id":"link","label":"Banner link"}],"presets":[{"name":"Image banner"}]}
{% endschema %}
