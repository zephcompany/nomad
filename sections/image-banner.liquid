<section class="hero hero--asset-banner">
  {% if section.settings.link != blank %}<a href="{{ section.settings.link }}" class="hero__link">{% endif %}

  <picture class="hero__picture">
    {% if section.settings.image_mobile != blank %}
      <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 1600 }}">
    {% else %}
      <source media="(max-width: 767px)" srcset="{{ 'banner mobile.png' | asset_url }}">
    {% endif %}

    {% if section.settings.image_desktop != blank %}
      {{ section.settings.image_desktop | image_url: width: 3200 | image_tag: class: 'hero__image', widths: '1200,1600,2000,2600,3200', loading: 'eager', fetchpriority: 'high', alt: section.settings.alt }}
    {% else %}
      <img class="hero__image" src="{{ 'banner desktop.png' | asset_url }}" alt="{{ section.settings.alt | escape }}" loading="eager" fetchpriority="high">
    {% endif %}
  </picture>

  {% if section.settings.link != blank %}</a>{% endif %}
</section>

<style>
  .hero--asset-banner,
  .hero--asset-banner .hero__link,
  .hero--asset-banner .hero__picture {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    overflow: hidden;
  }

  .hero--asset-banner .hero__image {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    margin: 0;
    object-fit: contain;
    object-position: center;
  }
</style>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop banner override" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile banner override" },
    { "type": "text", "id": "alt", "label": "Alt text", "default": "NØMAD collection" },
    { "type": "url", "id": "link", "label": "Banner link" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
