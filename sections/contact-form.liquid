<section class="page-width rte"><p class="eyebrow">NØMAD support</p><h1>Contact us</h1><p>Questions about an order, sizing or shipping? Send us a message.</p>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p>Thanks. We’ll get back to you soon.</p>{% endif %}{{ form.errors | default_errors }}<input type="text" name="contact[name]" placeholder="Name" required><input type="email" name="contact[email]" placeholder="Email" required><input type="text" name="contact[order_number]" placeholder="Order number (optional)"><textarea name="contact[body]" placeholder="How can we help?" required></textarea><button class="btn" type="submit">Send message</button>{% endform %}</section>{% schema %}{"name":"Contact form","settings":[]}{% endschema %}
