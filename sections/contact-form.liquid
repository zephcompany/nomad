<section class="nomad-contact">
  <div class="page-width nomad-contact__grid">
    <div class="nomad-contact__intro">
      <p class="eyebrow">NØMAD SUPPORT</p>
      <h1>HOW CAN<br>WE HELP?</h1>
      <p class="nomad-contact__lead">Questions about your order, sizing, shipping or anything NØMAD? Send us a message and our team will get back to you.</p>
      <div class="nomad-contact__topics">
        <div><span>01</span><strong>Orders</strong><p>Questions about an existing order or purchase.</p></div>
        <div><span>02</span><strong>Sizing & fit</strong><p>Need help choosing the right size or fit?</p></div>
        <div><span>03</span><strong>Shipping</strong><p>Delivery, tracking and shipping questions.</p></div>
        <div><span>04</span><strong>General</strong><p>Anything else you want to talk to us about.</p></div>
      </div>
    </div>

    <div class="nomad-contact__form-wrap">
      <div class="nomad-contact__form-head"><span>CONTACT</span><span>NØMAD</span></div>
      {% form 'contact', class: 'nomad-contact__form' %}
        {% if form.posted_successfully? %}<div class="nomad-contact__success">Message sent. We’ll get back to you as soon as possible.</div>{% endif %}
        {{ form.errors | default_errors }}
        <div class="nomad-contact__field"><label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" placeholder="Your name" required></div>
        <div class="nomad-contact__field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" placeholder="you@email.com" required></div>
        <div class="nomad-contact__field"><label for="ContactOrder">Order number</label><input id="ContactOrder" type="text" name="contact[order_number]" placeholder="#0000 (optional)"></div>
        <div class="nomad-contact__field"><label for="ContactTopic">Topic</label><select id="ContactTopic" name="contact[topic]"><option>Orders</option><option>Sizing & fit</option><option>Shipping</option><option>General</option></select></div>
        <div class="nomad-contact__field nomad-contact__field--full"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" placeholder="Tell us how we can help..." required></textarea></div>
        <button class="nomad-contact__submit" type="submit">Send message <span>→</span></button>
      {% endform %}
    </div>
  </div>
</section>

<style>
  .nomad-contact{padding:92px 0 120px;background:#fff}.nomad-contact__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(460px,1.1fr);gap:100px;align-items:start}.nomad-contact__intro h1{font-size:clamp(58px,7vw,108px);line-height:.86;letter-spacing:-.065em;font-weight:600;margin:18px 0 34px}.nomad-contact__lead{max-width:520px;color:#555;font-size:16px;line-height:1.65;margin:0}.nomad-contact__topics{margin-top:70px;border-top:1px solid #d9d9d9}.nomad-contact__topics div{display:grid;grid-template-columns:46px 150px 1fr;gap:16px;padding:20px 0;border-bottom:1px solid #d9d9d9;align-items:start}.nomad-contact__topics span{font-size:10px;letter-spacing:.12em;color:#888}.nomad-contact__topics strong{font-size:12px;text-transform:uppercase;letter-spacing:.1em;font-weight:600}.nomad-contact__topics p{font-size:12px;color:#666;margin:0;line-height:1.55}.nomad-contact__form-wrap{background:#0b0b0b;color:#fff;padding:34px 36px 40px}.nomad-contact__form-head{display:flex;justify-content:space-between;padding-bottom:28px;border-bottom:1px solid #303030;font-size:10px;letter-spacing:.14em}.nomad-contact__form{display:grid;grid-template-columns:1fr 1fr;gap:0 18px;padding-top:16px}.nomad-contact__field{padding:20px 0;border-bottom:1px solid #333}.nomad-contact__field--full{grid-column:1/-1}.nomad-contact__field label{display:block;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#888;margin-bottom:9px}.nomad-contact__field input,.nomad-contact__field select,.nomad-contact__field textarea{width:100%;border:0;background:transparent;color:#fff;padding:4px 0;outline:0;border-radius:0;font-size:14px}.nomad-contact__field input::placeholder,.nomad-contact__field textarea::placeholder{color:#666}.nomad-contact__field option{color:#111;background:#fff}.nomad-contact__field textarea{min-height:150px;resize:vertical}.nomad-contact__submit{grid-column:1/-1;margin-top:28px;width:100%;height:58px;background:#fff;color:#111;border:1px solid #fff;display:flex;align-items:center;justify-content:space-between;padding:0 20px;text-transform:uppercase;letter-spacing:.12em;font-size:10px;cursor:pointer}.nomad-contact__submit:hover{background:transparent;color:#fff}.nomad-contact__success{grid-column:1/-1;margin:12px 0 6px;padding:14px 16px;border:1px solid #444;font-size:12px}.nomad-contact__form .errors{grid-column:1/-1;color:#fff;font-size:12px}@media(max-width:990px){.nomad-contact{padding:68px 0 90px}.nomad-contact__grid{grid-template-columns:1fr;gap:58px}.nomad-contact__topics{margin-top:48px}}@media(max-width:640px){.nomad-contact{padding:52px 0 70px}.nomad-contact__intro h1{font-size:56px;margin-bottom:26px}.nomad-contact__lead{font-size:14px}.nomad-contact__topics div{grid-template-columns:32px 110px 1fr;gap:10px}.nomad-contact__form-wrap{margin:0 -14px;padding:28px 20px 32px}.nomad-contact__form{grid-template-columns:1fr}.nomad-contact__field,.nomad-contact__field--full{grid-column:1}.nomad-contact__submit{grid-column:1}}
</style>

{% schema %}{"name":"Contact form","settings":[]}{% endschema %}
