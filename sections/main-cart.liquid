<section class="page-width cart-page"><div class="section-head"><div><p class="eyebrow">Your order</p><h1 class="section-title">Cart</h1></div></div>{% if cart.item_count > 0 %}{% form 'cart', cart %}{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{{ item.image | image_url: width: 300 | image_tag: alt: item.product.title }}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><div class="product-card__price">{{ item.variant.title }}</div><div style="margin-top:10px"><input type="number" name="updates[]" min="0" value="{{ item.quantity }}" style="width:70px;padding:8px;border:1px solid #ccc"></div></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}<div class="cart-summary"><div style="display:flex;justify-content:space-between;margin-bottom:20px"><strong>Subtotal</strong><strong>{{ cart.total_price | money }}</strong></div><p class="product-card__price">Taxes and shipping calculated at checkout.</p><button class="add-to-cart" type="submit" name="checkout">Checkout</button><button type="submit" class="section-link" style="margin-top:16px;background:none;border-width:0 0 1px;padding:0 0 4px">Update cart</button></div>{% endform %}{% else %}<div class="empty-state"><h1>Your cart is empty.</h1><a class="btn" href="/collections/t-shirts">Shop T-Shirts</a></div>{% endif %}</section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
