{% assign collection = section.settings.collection %}
<section class="section featured-products-home">
  <div class="page-width">
    <div class="section-head">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="section-title">{{ section.settings.heading }}</h2></div>
      {% if collection != blank %}<a class="section-link" href="{{ collection.url }}">View all</a>{% endif %}
    </div>

    <div class="product-grid">
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <article class="product-card" data-product-card>
            <a class="product-card__image-link" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              <div class="product-card__media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'product-card__primary', widths: '360,540,720,1000,1200', loading: 'lazy', alt: product.title }}
                {% endif %}
                {% if product.images[2] %}
                  {{ product.images[2] | image_url: width: 1200 | image_tag: class: 'product-card__hover', widths: '360,540,720,1000,1200', loading: 'lazy', alt: product.title }}
                {% endif %}
              </div>
            </a>

            <div class="product-card__meta">
              <h3 class="product-card__title">{{ product.title }}</h3>
              <div class="product-card__row">
                <span class="product-card__price">{% render 'usd-price', price: product.price %}</span>

                {% assign color_option = product.options_by_name['Color'] %}
                {% if color_option != blank %}
                  <div class="swatches" aria-label="Choose color" data-card-swatches>
                    {% for color in color_option.values %}
                      {% assign color_variant = product.variants | where: 'option1', color | first %}
                      {% assign image_index = forloop.index0 %}
                      {% assign swatch_image = product.images[image_index] %}
                      {% if color_variant.featured_image %}{% assign swatch_image = color_variant.featured_image %}{% endif %}
                      {% if swatch_image %}
                        <button
                          class="swatch swatch--{{ color | handleize }}{% if forloop.first %} is-active{% endif %}"
                          type="button"
                          aria-label="{{ color | escape }}"
                          title="{{ color | escape }}"
                          data-color-swatch
                          data-image="{{ swatch_image | image_url: width: 1200 }}"
                        ></button>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}<article class="product-card"><div class="product-card__media"></div><div class="product-card__meta"><h3 class="product-card__title">Choose collection in Customize</h3><div class="product-card__price">$59.00</div></div></article>{% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NØMAD essentials"},{"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
