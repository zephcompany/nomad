<section class="page-width">
  <header class="collection-head"><p class="eyebrow">NØMAD collection</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="product-description">{{ collection.description }}</div>{% endif %}</header>
  {% paginate collection.products by 24 %}
    <div class="product-grid">
      {% for product in collection.products %}
        <article class="product-card"><a href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: class: 'product-card__primary', widths: '360,540,720,1000', loading: 'lazy', alt: product.title }}{% endif %}{% if product.images[1] %}{{ product.images[1] | image_url: width: 1000 | image_tag: class: 'product-card__hover', widths: '360,540,720,1000', loading: 'lazy', alt: product.title }}{% endif %}</div><div class="product-card__meta"><h2 class="product-card__title">{{ product.title }}</h2><div class="product-card__row"><span class="product-card__price">{{ product.price | money }}</span><span class="swatches"><i class="swatch swatch--black"></i><i class="swatch swatch--white"></i></span></div></div></a></article>
      {% else %}<div class="empty-state"><h2>No products yet.</h2></div>{% endfor %}
    </div>
    {% if paginate.pages > 1 %}<div style="display:flex;justify-content:center;gap:20px;padding:60px 0">{{ paginate | default_pagination }}</div>{% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
