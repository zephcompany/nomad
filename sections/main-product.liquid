<section class="page-width product-page">
  <div class="product-media-viewer" data-product-gallery>
    {% assign current_media = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}

    <div class="product-gallery__main">
      {% if current_media %}
        {{ current_media | image_url: width: 1800 | image_tag: class: 'product-gallery__main-image', widths: '600,900,1200,1600,1800', loading: 'eager', fetchpriority: 'high', alt: product.title, data-product-main-image: '' }}
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="product-gallery__thumbs" aria-label="Product images">
        {% for image in product.images %}
          <button
            class="product-gallery__thumb{% if image.id == current_media.id %} is-active{% endif %}"
            type="button"
            aria-label="View image {{ forloop.index }}"
            data-gallery-thumbnail
            data-image-id="{{ image.id }}"
            data-image-src="{{ image | image_url: width: 1800 }}"
            data-image-alt="{{ product.title | escape }}"
          >
            {{ image | image_url: width: 220 | image_tag: widths: '90,140,220', loading: 'lazy', alt: product.title }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-info">
    <p class="eyebrow">NØMAD</p>
    <h1>{{ product.title }}</h1>
    <div class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>

    {% form 'product', product, data-product-form: '' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      {% for option in product.options_with_values %}
        <fieldset class="option" data-option-index="{{ forloop.index0 }}">
          <label>{{ option.name }}</label>
          <div class="option-values">
            {% for value in option.values %}
              <label>
                <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                <span>{{ value }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>
      {% endfor %}

      {% unless product.options contains 'Size' %}
        <fieldset class="option option--size">
          <label>Size</label>
          <div class="option-values option-values--size">
            {% assign nomad_sizes = 'S,M,L,XL' | split: ',' %}
            {% for size in nomad_sizes %}
              <label>
                <input type="radio" name="properties[Size]" value="{{ size }}" {% if forloop.first %}required{% endif %}>
                <span>{{ size }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>
      {% endunless %}

      <button class="add-to-cart" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}
      </button>
      <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
    {% endform %}

    <div class="product-description">{{ product.description }}</div>
  </div>
</section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
